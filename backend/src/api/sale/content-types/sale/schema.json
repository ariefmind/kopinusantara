{
  "kind": "collectionType",
  "collectionName": "sales",
  "info": {
    "singularName": "sale",
    "pluralName": "sales",
    "displayName": "Sale",
    "description": "Catatan penjualan dari website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderRef": {
      "type": "string",
      "unique": true
    },
    "customerName": {
      "type": "string",
      "required": true
    },
    "customerPhone": {
      "type": "string"
    },
    "customerEmail": {
      "type": "email"
    },
    "customerAddress": {
      "type": "text"
    },
    "items": {
      "type": "json"
    },
    "total": {
      "type": "decimal"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "confirmed",
        "paid",
        "shipped",
        "done",
        "cancelled"
      ],
      "default": "pending"
    },
    "source": {
      "type": "string",
      "default": "web"
    }
  }
}