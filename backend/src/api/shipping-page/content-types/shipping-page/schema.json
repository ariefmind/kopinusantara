{
  "kind": "singleType",
  "collectionName": "shipping_pages",
  "info": {
    "singularName": "shipping-page",
    "pluralName": "shipping-pages",
    "displayName": "Shipping Page",
    "description": "Konten halaman Shipping & Export"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroEyebrow": {
      "type": "string",
      "default": "Wholesale & Export"
    },
    "heroTitle": {
      "type": "string",
      "default": ""
    },
    "heroSubtitle": {
      "type": "text"
    },
    "termsHeading": {
      "type": "string",
      "default": "Trade terms"
    },
    "terms": {
      "type": "component",
      "repeatable": true,
      "component": "page.term"
    },
    "packagingHeading": {
      "type": "string",
      "default": "Packaging options"
    },
    "packaging": {
      "type": "component",
      "repeatable": true,
      "component": "page.pack"
    },
    "processHeading": {
      "type": "string",
      "default": "How ordering works"
    },
    "process": {
      "type": "component",
      "repeatable": true,
      "component": "page.step"
    },
    "faqHeading": {
      "type": "string",
      "default": "Frequently asked"
    },
    "faq": {
      "type": "component",
      "repeatable": true,
      "component": "page.faq"
    },
    "ctaTitle": {
      "type": "string",
      "default": "Ready to source your first lot?"
    },
    "ctaHref": {
      "type": "string",
      "default": "contact.html"
    },
    "ctaText": {
      "type": "string",
      "default": "Start an inquiry →"
    }
  }
}